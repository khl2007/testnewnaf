# Create a free app at https://dashboard.pusher.com/ → Channels → Create app
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# Shared secret (generate: openssl rand -hex 32) — same on agent + relay
PUSHER_TUNNEL_KEY=

# Local agent → your iam-gateway-server.mjs
IAM_GATEWAY_URL=http://127.0.0.1:8787

# Public relay (optional HTTP front)
PUSHER_RELAY_PORT=8788
