# API endpoint for the IAM gateway (or deployed pusher relay)
# Supports:
#   - Base URL: http://127.0.0.1:8787 or https://your-service.up.railway.app
#   - Path with /api: http://127.0.0.1:8787/api
#   - Full path: http://127.0.0.1:8787/api/iam
# If not set, defaults to "/api/iam" (uses Vite's local dev proxy)
VITE_IAM_API_URL=http://127.0.0.1:8787

# Optional: override health check URL (defaults to /api/health or derived from VITE_IAM_API_URL)
# VITE_HEALTH_API_URL=http://127.0.0.1:8787/api/health

# Optional: set to 0 or false to disable live IAM forwarding
# VITE_ALLOW_LIVE_IAM=true
